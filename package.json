{
  "name": "gr-simple-md-renderer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:release": "vite build --mode release",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "vite build --outDir ../output/e2e --emptyOutDir",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:firefox": "npm run build:e2e && playwright test --config playwright.firefox.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "jsdom": "^28.1.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.11",
    "marked": "^18.1.0",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^11.17.2",
    "plantuml-encoder": "^1.4.0"
  }
}
